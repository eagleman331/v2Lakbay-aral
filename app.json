{
  "expo": {
    "name": "lakbay-aral",
    "slug": "lakbay-aral",
    "version": "1.0.0",
    "scheme": "lakbay-aral",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/lakbay-aralIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eagleman33.lakbayaral",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/lakbay-aralIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.eagleman33.lakbayaral",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAql_lhkfFzAyHoXJ1lvXjrjzlREj4v17c"
        }
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "030212b1-0548-4693-b976-3a2bf3c892f5"
      }
    }
  }
}
